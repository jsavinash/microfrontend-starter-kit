#!/bin/sh
# =============================================================================
# Pre-commit Hook — Microfrontend Starter Kit
# =============================================================================
# This hook runs before every commit to enforce code quality, type safety,
# and prevent common issues from being committed.
#
# Stages:
#   1. Lint-staged — Auto-fix ESLint + Prettier on staged files
#   2. TypeScript Check — Type-check changed files (turbo typecheck)
#   3. Unit Tests — Run tests for changed packages
#   4. Debug Artifact Check — Prevent console.log, debugger, etc.
#   5. Large File Check — Warn about files > 1MB
#   6. CI/CD Validation — Validate GitHub Actions workflows and deployment configs
#   7. Dependency Audit — Check for known vulnerabilities
# =============================================================================

# ---- Color output helpers ----
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo ""
echo "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
echo "${CYAN}  🔍 Pre-commit Checks${NC}"
echo "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
echo ""

# ---- Track failures ----
FAILED=0

# =============================================================================
# Stage 1: Lint-staged (ESLint + Prettier on staged files)
# =============================================================================
echo "${YELLOW}[1/7] Running lint-staged (ESLint + Prettier)...${NC}"
npx lint-staged
LINT_STAGED_EXIT=$?
if [ $LINT_STAGED_EXIT -ne 0 ]; then
    echo "${RED}  ✖ lint-staged failed. Fix the errors above and try again.${NC}"
    FAILED=1
else
    echo "${GREEN}  ✓ lint-staged passed${NC}"
fi
echo ""

# =============================================================================
# Stage 2: TypeScript Type Checking
# =============================================================================
echo "${YELLOW}[2/7] Running TypeScript type check...${NC}"

# Get changed .ts/.tsx files (staged)
CHANGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)

if [ -n "$CHANGED_TS_FILES" ]; then
    # Run turbo typecheck for all packages (cached, so fast for unchanged)
    pnpm turbo typecheck 2>&1
    TYPECHECK_EXIT=$?
    if [ $TYPECHECK_EXIT -ne 0 ]; then
        echo "${RED}  ✖ TypeScript type checking failed. Fix type errors above.${NC}"
        FAILED=1
    else
        echo "${GREEN}  ✓ TypeScript type check passed${NC}"
    fi
else
    echo "${GREEN}  ✓ No TypeScript files changed, skipping type check${NC}"
fi
echo ""

# =============================================================================
# Stage 3: Run tests for changed packages
# =============================================================================
echo "${YELLOW}[3/7] Running tests for changed packages...${NC}"

# Detect which packages/apps have changed files
CHANGED_PACKAGES=""
for file in $(git diff --cached --name-only --diff-filter=ACMR); do
    case "$file" in
        apps/host-shell/*)
            if ! echo "$CHANGED_PACKAGES" | grep -q "@repo/host-shell"; then
                CHANGED_PACKAGES="$CHANGED_PACKAGES --filter @repo/host-shell"
            fi
            ;;
        apps/mfe-auth/*)
            if ! echo "$CHANGED_PACKAGES" | grep -q "@repo/mfe-auth"; then
                CHANGED_PACKAGES="$CHANGED_PACKAGES --filter @repo/mfe-auth"
            fi
            ;;
        apps/mfe-dashboard/*)
            if ! echo "$CHANGED_PACKAGES" | grep -q "@repo/mfe-dashboard"; then
                CHANGED_PACKAGES="$CHANGED_PACKAGES --filter @repo/mfe-dashboard"
            fi
            ;;
        packages/ui-components/*)
            if ! echo "$CHANGED_PACKAGES" | grep -q "@repo/ui-components"; then
                CHANGED_PACKAGES="$CHANGED_PACKAGES --filter @repo/ui-components"
            fi
            ;;
        packages/utils/*)
            if ! echo "$CHANGED_PACKAGES" | grep -q "@repo/utils"; then
                CHANGED_PACKAGES="$CHANGED_PACKAGES --filter @repo/utils"
            fi
            ;;
    esac
done

if [ -n "$CHANGED_PACKAGES" ]; then
    # shellcheck disable=SC2086
    pnpm turbo test $CHANGED_PACKAGES 2>&1
    TEST_EXIT=$?
    if [ $TEST_EXIT -ne 0 ]; then
        echo "${RED}  ✖ Tests failed for changed packages. Fix failing tests.${NC}"
        FAILED=1
    else
        echo "${GREEN}  ✓ Tests passed for changed packages${NC}"
    fi
else
    echo "${GREEN}  ✓ No package changes detected, skipping tests${NC}"
fi
echo ""

# =============================================================================
# Stage 4: Debug Artifact Check
# =============================================================================
echo "${YELLOW}[4/7] Checking for debug artifacts...${NC}"

# Check for console.log, debugger, .only in tests, TODO/FIXME markers
DEBUG_ISSUES=0

# Check for debugger statements
DEBUGGER_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx)$' || true)
if [ -n "$DEBUGGER_FILES" ]; then
    for file in $DEBUGGER_FILES; do
        # Check for debugger;
        if git show ":${file}" | grep -n "debugger;" > /dev/null 2>&1; then
            echo "${RED}  ✖ 'debugger;' found in: ${file}${NC}"
            DEBUG_ISSUES=$((DEBUG_ISSUES + 1))
        fi

        # Check for .only in test files
        if echo "$file" | grep -E '\.(test|spec)\.(ts|tsx|js|jsx)$' > /dev/null 2>&1; then
            if git show ":${file}" | grep -n "\.only" > /dev/null 2>&1; then
                echo "${RED}  ✖ '.only' found in test file: ${file}${NC}"
                DEBUG_ISSUES=$((DEBUG_ISSUES + 1))
            fi
        fi

        # Check for console.log (allow console.error and console.warn)
        if git show ":${file}" | grep -n "console\.log(" > /dev/null 2>&1; then
            # Only warn, don't block
            LINES=$(git show ":${file}" | grep -n "console\.log(" | head -3)
            echo "${YELLOW}  ⚠  console.log() found in: ${file}${NC}"
            echo "${YELLOW}     Lines: ${LINES}${NC}"
        fi
    done
fi

# Check for large TODO/FIXME blocks in staged files
TODO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx)$' || true)
if [ -n "$TODO_FILES" ]; then
    for file in $TODO_FILES; do
        TODO_COUNT=$(git show ":${file}" | grep -c "TODO\|FIXME\|HACK\|XXX" 2>/dev/null || echo 0)
        if [ "$TODO_COUNT" -gt 5 ]; then
            echo "${YELLOW}  ⚠  ${file} has ${TODO_COUNT} TODO/FIXME markers${NC}"
        fi
    done
fi

if [ $DEBUG_ISSUES -gt 0 ]; then
    echo "${RED}  ✖ Found ${DEBUG_ISSUES} debug artifact(s). Remove them and try again.${NC}"
    FAILED=1
else
    echo "${GREEN}  ✓ No debug artifacts found${NC}"
fi
echo ""

# =============================================================================
# Stage 5: Large File Check
# =============================================================================
echo "${YELLOW}[5/7] Checking for large files...${NC}"

LARGE_FILES=0
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [ -n "$STAGED_FILES" ]; then
    for file in $STAGED_FILES; do
        # Check if file exists (may have been deleted)
        if [ -f "$file" ]; then
            SIZE=$(wc -c < "$file")
            if [ "$SIZE" -gt 1048576 ]; then
                SIZE_MB=$(echo "scale=2; $SIZE / 1048576" | bc)
                echo "${RED}  ✖ ${file} is ${SIZE_MB}MB (max: 1MB)${NC}"
                LARGE_FILES=$((LARGE_FILES + 1))
            fi
        fi
    done
fi

if [ $LARGE_FILES -gt 0 ]; then
    echo "${RED}  ✖ Found ${LARGE_FILES} large file(s). Use .gitignore or git LFS.${NC}"
    FAILED=1
else
    echo "${GREEN}  ✓ No large files detected${NC}"
fi
echo ""

# =============================================================================
# Stage 6: CI/CD Validation
# =============================================================================
echo "${YELLOW}[6/7] Validating CI/CD configuration...${NC}"

CI_ISSUES=0

# Check if GitHub Actions workflow files are valid YAML
WORKFLOW_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^\.github/workflows/.*\.yml$' || true)
if [ -n "$WORKFLOW_FILES" ]; then
    for workflow in $WORKFLOW_FILES; do
        if [ -f "$workflow" ]; then
            # Basic YAML syntax check (if yq is available)
            if command -v yq > /dev/null 2>&1; then
                if ! yq eval "$workflow" > /dev/null 2>&1; then
                    echo "${RED}  ✖ Invalid YAML syntax in: ${workflow}${NC}"
                    CI_ISSUES=$((CI_ISSUES + 1))
                else
                    echo "${GREEN}  ✓ Valid YAML: ${workflow}${NC}"
                fi
            else
                # Fallback: check for required keys
                if ! grep -q "^name:" "$workflow"; then
                    echo "${YELLOW}  ⚠  Missing 'name' in workflow: ${workflow}${NC}"
                fi
                if ! grep -q "^on:" "$workflow"; then
                    echo "${YELLOW}  ⚠  Missing 'on' trigger in workflow: ${workflow}${NC}"
                fi
                if ! grep -q "^jobs:" "$workflow"; then
                    echo "${RED}  ✖ Missing 'jobs' in workflow: ${workflow}${NC}"
                    CI_ISSUES=$((CI_ISSUES + 1))
                fi
            fi
        fi
    done
fi

# Validate Vite configs have required production settings
VITE_CONFIGS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E 'vite\.config\.(ts|js)$' || true)
if [ -n "$VITE_CONFIGS" ]; then
    for config in $VITE_CONFIGS; do
        if [ -f "$config" ]; then
            # Check for base path configuration (needed for GitHub Pages)
            if ! grep -q "base:" "$config" && ! grep -q "base =" "$config"; then
                echo "${YELLOW}  ⚠  Missing 'base' configuration in ${config} (needed for GitHub Pages)${NC}"
            fi
            
            # Check for module federation plugin
            if ! grep -q "federation" "$config" && ! grep -q "@originjs/vite-plugin-federation" "$config"; then
                echo "${YELLOW}  ⚠  Missing Module Federation config in ${config}${NC}"
            fi
        fi
    done
fi

# Check for .nojekyll file (required for GitHub Pages)
if git diff --cached --name-only | grep -q "\.nojekyll"; then
    echo "${GREEN}  ✓ .nojekyll file detected (GitHub Pages compatible)${NC}"
fi

# Validate package.json scripts exist
if git diff --cached --name-only | grep -q "package.json"; then
    if ! grep -q '"build"' package.json; then
        echo "${RED}  ✖ Missing 'build' script in package.json${NC}"
        CI_ISSUES=$((CI_ISSUES + 1))
    fi
    if ! grep -q '"test"' package.json; then
        echo "${RED}  ✖ Missing 'test' script in package.json${NC}"
        CI_ISSUES=$((CI_ISSUES + 1))
    fi
    if ! grep -q '"lint"' package.json; then
        echo "${RED}  ✖ Missing 'lint' script in package.json${NC}"
        CI_ISSUES=$((CI_ISSUES + 1))
    fi
fi

if [ $CI_ISSUES -gt 0 ]; then
    echo "${RED}  ✖ Found ${CI_ISSUES} CI/CD configuration issue(s). Fix them and try again.${NC}"
    FAILED=1
else
    echo "${GREEN}  ✓ CI/CD configuration valid${NC}"
fi
echo ""

# =============================================================================
# Stage 7: Dependency Audit (only for new/modified lockfile)
# =============================================================================
echo "${YELLOW}[7/7] Checking dependency security...${NC}"

LOCKFILE_CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -c "pnpm-lock.yaml" || true)
if [ "$LOCKFILE_CHANGED" -gt 0 ]; then
    echo "  Lockfile changed, running security audit..."
    pnpm audit --audit-level=high 2>&1 | tail -5
    AUDIT_EXIT=$?
    if [ $AUDIT_EXIT -ne 0 ]; then
        echo "${YELLOW}  ⚠  High severity vulnerabilities found. Review and fix.${NC}"
        # Don't block commit for audit warnings, just warn
    else
        echo "${GREEN}  ✓ No high severity vulnerabilities${NC}"
    fi
else
    echo "${GREEN}  ✓ Lockfile unchanged, skipping audit${NC}"
fi
echo ""

# =============================================================================
# Summary
# =============================================================================
echo "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
if [ $FAILED -eq 0 ]; then
    echo "${GREEN}  ✅ All pre-commit checks passed!${NC}"
    echo "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    exit 0
else
    echo "${RED}  ❌ Some pre-commit checks failed.${NC}"
    echo "${RED}     Fix the issues above and run 'git commit' again.${NC}"
    echo "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    exit 1
fi